# Optional server-only environment. Never commit real keys or tokens.
REVERSECAD_DATA_DIR=var/service
# Generated locally if unset; read the private pairing-token file named by startup
# and enter its contents on the phone. Startup prints the path, not the token.
# REVERSECAD_PAIRING_TOKEN=
# Optional live reasoning. Without this, manual and fixture modes still work.
# OPENAI_API_KEY=
REVERSECAD_OPENAI_MODEL=gpt-6-astra
REVERSECAD_OPENAI_REASONING=high
REVERSECAD_OPENAI_TIMEOUT=60
# Live request consent must also be explicit in the app.

# Optional Grok visual adviser for saved 3x3 exterior scans.
# Sends bounded, guide-cropped grayscale images to xAI; keys stay on the Mac.
# Geometry and physical-fit checks remain separate.
XAI_API_KEY=
REVERSECAD_GROK_ENABLED=false
REVERSECAD_GROK_MODEL=grok-4.20-0309-non-reasoning
REVERSECAD_GROK_TIMEOUT=20
REVERSECAD_GROK_REASONING=low
REVERSECAD_GROK_APPLY_SELECTIONS=false

{
  "$defs": {
    "Segment": {
      "additionalProperties": true,
      "properties": {
        "segment_id": {
          "title": "Segment Id",
          "type": "string"
        },
        "T_object_world": {
          "items": {
            "type": "number"
          },
          "maxItems": 16,
          "minItems": 16,
          "title": "T Object World",
          "type": "array"
        },
        "registered": {
          "title": "Registered",
          "type": "boolean"
        }
      },
      "required": [
        "segment_id",
        "T_object_world",
        "registered"
      ],
      "title": "Segment",
      "type": "object"
    },
    "SparseCapture": {
      "additionalProperties": true,
      "description": "Independent packet stream; never represented as a processed depth plane.",
      "properties": {
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "mode": {
          "const": "sparse_range_rgb",
          "title": "Mode",
          "type": "string"
        },
        "status": {
          "enum": [
            "capturing",
            "available",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        },
        "packet_path": {
          "title": "Packet Path",
          "type": "string"
        },
        "event_path": {
          "title": "Event Path",
          "type": "string"
        },
        "calibration_path": {
          "title": "Calibration Path",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "mode",
        "status",
        "packet_path",
        "event_path",
        "calibration_path"
      ],
      "title": "SparseCapture",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "scan_id": {
      "title": "Scan Id",
      "type": "string"
    },
    "source": {
      "enum": [
        "synthetic",
        "arkit",
        "camera_manual"
      ],
      "title": "Source",
      "type": "string"
    },
    "device": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Device",
      "type": "string"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "complete": {
      "title": "Complete",
      "type": "boolean"
    },
    "segments": {
      "items": {
        "$ref": "#/$defs/Segment"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Segments",
      "type": "array"
    },
    "frame_count": {
      "maximum": 240,
      "minimum": 1,
      "title": "Frame Count",
      "type": "integer"
    },
    "sparse_capture": {
      "anyOf": [
        {
          "$ref": "#/$defs/SparseCapture"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "schema_version",
    "scan_id",
    "source",
    "device",
    "created_at",
    "complete",
    "segments",
    "frame_count"
  ],
  "title": "ScanManifest",
  "type": "object"
}
